# Built installer & app bundle output
dist/
pkg-build/payload/
*.app/

# Runtime files (generated while the daemon is running)
job_agent/daemon.pid
job_agent/status.json
job_agent/run_now.flag

# Personal config (contains your phone number / Apple ID)
job_agent/config.json

# Job history database
job_agent/seen_jobs.db

# Logs
*.log

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/

# Node & Next.js
**/node_modules/
**/.next/
frontend/out/

# User data & credentials
job_agent/data/resumes/*
!job_agent/data/resumes/.gitkeep
job_agent/data/sessions/*
!job_agent/data/sessions/.gitkeep
job_agent/data/screenshots/*
!job_agent/data/screenshots/.gitkeep
job_agent/data/profiles/*
!job_agent/data/profiles/.gitkeep
data/

# macOS
.DS_Store

# Playwright browsers (large, installed locally)
**/ms-playwright/

