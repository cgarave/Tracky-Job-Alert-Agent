#!/usr/bin/env bash
# =============================================================================
#  postinstall — runs AFTER files are copied to /usr/local/share/jobagent/
#
#  Fast, non-blocking post-installation script for Tracky.
# =============================================================================
set -euo pipefail

INSTALL_DIR="/usr/local/share/jobagent"
CURRENT_USER=$(stat -f "%Su" /dev/console 2>/dev/null || echo "$USER")
CURRENT_USER_HOME=$(eval echo ~"$CURRENT_USER")
LOG_FILE="$CURRENT_USER_HOME/Library/Logs/jobagent.log"
MENUBAR_LOG_FILE="$CURRENT_USER_HOME/Library/Logs/jobagent-menubar.log"
PLIST_DEST="$CURRENT_USER_HOME/Library/LaunchAgents/com.jobagent.plist"
MENUBAR_PLIST_DEST="$CURRENT_USER_HOME/Library/LaunchAgents/com.jobagent.menubar.plist"

run_as_user() {
    if [ "$(id -u)" -eq 0 ]; then
        sudo -u "$CURRENT_USER" "$@"
    else
        "$@"
    fi
}

# ── 1. Find Python 3.11+ ─────────────────────────────────────────────────────
find_python() {
    # 1. First check active python3 in user environment
    local shell_py
    shell_py=$(run_as_user which python3 2>/dev/null || which python3 2>/dev/null || echo "")
    if [ -n "$shell_py" ] && [ -x "$shell_py" ]; then
        if "$shell_py" -c "import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)" 2>/dev/null; then
            echo "$shell_py"
            return 0
        fi
    fi

    # 2. Check standard Frameworks & Homebrew paths
    local candidates=(
        "/Library/Frameworks/Python.framework/Versions/3.11/bin/python3"
        "/Library/Frameworks/Python.framework/Versions/Current/bin/python3"
        "/opt/homebrew/bin/python3"
        "/usr/local/bin/python3"
        "/Library/Frameworks/Python.framework/Versions/3.12/bin/python3"
        "/Library/Frameworks/Python.framework/Versions/3.13/bin/python3"
        "/Library/Frameworks/Python.framework/Versions/3.14/bin/python3"
        "$CURRENT_USER_HOME/.pyenv/shims/python3"
    )

    for py in "${candidates[@]}"; do
        if [ -x "$py" ]; then
            if "$py" -c "import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)" 2>/dev/null; then
                echo "$py"
                return 0
            fi
        fi
    done

    echo "/Library/Frameworks/Python.framework/Versions/Current/bin/python3"
}

PYTHON=$(find_python)

# ── 2. Install Python dependencies (fast, non-blocking) ──────────────────────
if [ -f "$INSTALL_DIR/requirements.txt" ]; then
    run_as_user "$PYTHON" -m pip install \
        -r "$INSTALL_DIR/requirements.txt" \
        --quiet \
        --no-warn-script-location \
        2>/dev/null || true
fi

# ── 3. Initialize config.json (preserve existing config if user already has one)
CONFIG_FILE="$INSTALL_DIR/job_agent/config.json"
mkdir -p "$INSTALL_DIR/job_agent"

if [ ! -f "$CONFIG_FILE" ]; then
    cat > "$CONFIG_FILE" <<CONFIG
{
  "recipient": "",
  "keywords": [
    "software engineer",
    "frontend engineer",
    "web developer",
    "ai engineer",
    "full stack developer",
    "react developer"
  ],
  "location": "Philippines",
  "check_interval_minutes": 60,
  "max_results_per_keyword": 10,
  "paused": false
}
CONFIG
fi

if [ "$(id -u)" -eq 0 ]; then
    chown -R "$CURRENT_USER" "$INSTALL_DIR" 2>/dev/null || true
    chmod -R 777 "$INSTALL_DIR/job_agent" 2>/dev/null || true
fi

# ── 4. Create and load Daemon LaunchAgent ─────────────────────────────────────
mkdir -p "$CURRENT_USER_HOME/Library/LaunchAgents"
mkdir -p "$CURRENT_USER_HOME/Library/Logs"

cat > "$PLIST_DEST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jobagent</string>
    <key>ProgramArguments</key>
    <array>
        <string>$PYTHON</string>
        <string>$INSTALL_DIR/job_agent/main.py</string>
    </array>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>WorkingDirectory</key>
    <string>$INSTALL_DIR/job_agent</string>
    <key>StandardOutPath</key>
    <string>$LOG_FILE</string>
    <key>StandardErrorPath</key>
    <string>$LOG_FILE</string>
</dict>
</plist>
PLIST

if [ "$(id -u)" -eq 0 ]; then
    chown "$CURRENT_USER" "$PLIST_DEST" 2>/dev/null || true
fi
run_as_user launchctl unload "$PLIST_DEST" 2>/dev/null || true
run_as_user launchctl load "$PLIST_DEST" 2>/dev/null || true

# ── 5. Create and load Menu Bar LaunchAgent (Fixed XML array) ────────────────
cat > "$MENUBAR_PLIST_DEST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jobagent.menubar</string>
    <key>ProgramArguments</key>
    <array>
        <string>$PYTHON</string>
        <string>$INSTALL_DIR/job_agent/menu_bar.py</string>
    </array>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>WorkingDirectory</key>
    <string>$INSTALL_DIR/job_agent</string>
    <key>StandardOutPath</key>
    <string>$MENUBAR_LOG_FILE</string>
    <key>StandardErrorPath</key>
    <string>$MENUBAR_LOG_FILE</string>
</dict>
</plist>
PLIST

if [ "$(id -u)" -eq 0 ]; then
    chown "$CURRENT_USER" "$MENUBAR_PLIST_DEST" 2>/dev/null || true
fi
run_as_user launchctl unload "$MENUBAR_PLIST_DEST" 2>/dev/null || true
run_as_user launchctl load "$MENUBAR_PLIST_DEST" 2>/dev/null || true

# ── 6. Create 1-click launcher in ~/Applications/Tracky.app ──────────────────
mkdir -p "$CURRENT_USER_HOME/Applications"
run_as_user osacompile -o "$CURRENT_USER_HOME/Applications/Tracky.app" -e '
set homePath to POSIX path of (path to home folder)
set daemonPlist to homePath & "Library/LaunchAgents/com.jobagent.plist"
set menubarPlist to homePath & "Library/LaunchAgents/com.jobagent.menubar.plist"

do shell script "launchctl load " & quoted form of daemonPlist & " 2>/dev/null || true; launchctl load " & quoted form of menubarPlist & " 2>/dev/null || true; launchctl start com.jobagent.menubar 2>/dev/null || true"

display notification "Tracky scraper and menu bar are active." with title "Tracky Started" subtitle "🐶 Online"
' 2>/dev/null || true

if [ -f "$INSTALL_DIR/Tracky.icns" ]; then
    rm -f "$CURRENT_USER_HOME/Applications/Tracky.app/Contents/Resources/Assets.car" 2>/dev/null || true
    cp "$INSTALL_DIR/Tracky.icns" "$CURRENT_USER_HOME/Applications/Tracky.app/Contents/Resources/applet.icns" 2>/dev/null || true
    /usr/libexec/PlistBuddy -c "Delete :CFBundleIconName" "$CURRENT_USER_HOME/Applications/Tracky.app/Contents/Info.plist" 2>/dev/null || true
    touch "$CURRENT_USER_HOME/Applications/Tracky.app" 2>/dev/null || true
    run_as_user /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f -r "$CURRENT_USER_HOME/Applications/Tracky.app" 2>/dev/null || true
fi

if [ "$(id -u)" -eq 0 ]; then
    chown -R "$CURRENT_USER" "$CURRENT_USER_HOME/Applications/Tracky.app" 2>/dev/null || true
fi

# ── 7. Send non-blocking notification on complete ────────────────────────────
run_as_user osascript -e 'display notification "Tracky installed successfully! Click the 🐶 icon in your menu bar." with title "Tracky Ready" subtitle "Installation Complete"' 2>/dev/null || true

exit 0
