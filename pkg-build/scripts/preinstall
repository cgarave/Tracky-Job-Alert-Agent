#!/usr/bin/env bash
# =============================================================================
#  preinstall — runs BEFORE files are copied
#  Checks that a supported standard CPython runtime is available.
# =============================================================================
set -euo pipefail

CURRENT_USER=$(stat -f "%Su" /dev/console)

# Discover the newest supported interpreter before the payload is copied.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PYTHON=""
for probe in /usr/bin/python3 /opt/homebrew/bin/python3 /usr/local/bin/python3; do
    if [ -x "$probe" ]; then
        PYTHON=$(sudo -u "$CURRENT_USER" "$probe" "$SCRIPT_DIR/python_runtime.py" --path 2>/dev/null || echo "")
        [ -n "$PYTHON" ] && break
    fi
done

if [ -z "$PYTHON" ]; then
    osascript -e 'display alert "Python is required" message "Tracky requires standard CPython 3.11 or later.\n\nInstall the latest Python from https://python.org, then run the installer again." as critical buttons {"OK"} default button "OK"'
    exit 1
fi

PY_VERSION=$(sudo -u "$CURRENT_USER" "$PYTHON" -c "import sys; print(sys.version_info.major * 100 + sys.version_info.minor)" 2>/dev/null || echo "0")
if [ "$PY_VERSION" -lt 311 ]; then
    osascript -e 'display alert "A newer Python is required" message "Tracky requires standard CPython 3.11 or later.\n\nPlease update Python from https://python.org." as critical buttons {"OK"} default button "OK"'
    exit 1
fi

exit 0
